# ── Server ──────────────────────────────────────────────────────────────────
# Express API (Vite dev proxies /api here — keep in sync with vite.config.ts)
PORT=3005
NODE_ENV=development

# Where enquiry JSONL files are stored (defaults to server/data)
# DATA_DIR=

# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed in dev when using the Vite /api proxy; required in production.
CLIENT_ORIGIN=http://localhost:3000

# ── Clerk (clerk.com → your app → API keys) ─────────────────────────────────
# Secret key — server only, never expose to the browser.
CLERK_SECRET_KEY=sk_test_replace_me
# Publishable key — safe for the browser, read by Vite into the client.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Webhook signing secret (Clerk dashboard → Webhooks → your endpoint)
# CLERK_WEBHOOK_SECRET=whsec_replace_me

# ── Sentry (sentry.io → settings → client keys) ─────────────────────────────
# Server DSN — the farmbro-api project's DSN.
SENTRY_DSN=
# Browser DSN — the farmbro-web project's DSN, read by Vite into the client.
VITE_SENTRY_DSN=

# ── Legacy Manus OAuth vars (unused by the new auth; safe to delete) ────────
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
